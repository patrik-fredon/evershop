### 2. Integration Tests
```typescript
// Example: API integration tests
describe('Product API', () => {
  it('should require age verification', async () => {
    const response = await request(app)
      .get('/api/products')
      .expect(302)
      .expect('Location', '/age-verification');
  });

  it('should return products after age verification', async () => {
    const agent = request.agent(app);
    await agent.post('/age-verification').send({ age: 25 });

    const response = await agent
      .get('/api/products')
      .expect(200);

    expect(response.body.products).toHaveLength(20);
  });
});
